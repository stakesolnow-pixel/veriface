# mock | anthropic | fal | openai
VIDEO_PROVIDER=anthropic

# Required for VIDEO_PROVIDER=anthropic (Claude crafts the liveness prompt)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Required for real AI video with anthropic or fal (Kling image-to-video via fal.ai)
# Without FAL_KEY, anthropic falls back to local ffmpeg mock after Claude writes the prompt.
FAL_KEY=

# Legacy / proxy only — OpenAI public Sora Videos API was shut down 2026-09-24
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
