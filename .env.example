VIDEO_PROVIDER=mock

# Required only when VIDEO_PROVIDER=openai
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (proxies / self-hosted)
OPENAI_BASE_URL=https://api.openai.com/v1

# CORS for local Vite / production frontends
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional overrides
# VIDEO_SECONDS=12
# VIDEO_SIZE=1280x720
